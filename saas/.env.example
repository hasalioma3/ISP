# ISP Cloud master app. Copy to saas/.env and fill in. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,cloud.example.com
CSRF_TRUSTED_ORIGINS=https://localhost:9443,https://cloud.example.com
# Fernet key for secrets stored in the master DB (Daraja keys, tenants' DB
# passwords...). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes those secrets unreadable.
SAAS_ENCRYPTION_KEY=

# Shared Postgres (master DB + one DB per ISP)
POSTGRES_USER=saas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=saas_master

# First platform admin (created on first start if missing)
SAAS_ADMIN_EMAIL=admin@example.com
SAAS_ADMIN_PASSWORD=change-me-too

# Host name in the tenants' self-signed certificate
TENANT_CERT_HOST=localhost

# Email to ISP owners (console backend prints to the logs)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ISP Cloud <no-reply@example.com>

# Images the ISP instances run (saas/build_tenant_images.sh)
SAAS_IMAGE_PREFIX=isp-saas/tenant-
SAAS_IMAGE_TAG=latest
