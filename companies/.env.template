# Generated by provision_company.sh -- one of these per company, never
# committed to git (see .gitignore). MPESA_* and MIKROTIK_* are placeholders
# that MUST be filled in with this company's real credentials/router before
# they can take real payments or reach their router; everything else is
# ready to run as-is.

COMPANY_SLUG=__SLUG__
COMPANY_PORT=__PORT__

# Django
SECRET_KEY=__SECRET_KEY__
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,__HOST_IP__

# Database (shared Postgres server -- db/provision_company.sh creates this
# company's own dedicated database + role on it)
DATABASE_URL=postgresql://__DB_USER__:__DB_PASSWORD__@db:5432/__DB_NAME__
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=__DB_NAME__
SQL_USER=__DB_USER__
SQL_PASSWORD=__DB_PASSWORD__
SQL_HOST=db
SQL_PORT=5432
DATABASE=postgres

# Redis (shared instance -- dedicated logical DB index per company, so
# Celery queues never cross between companies)
CELERY_BROKER_URL=redis://redis:6379/__REDIS_INDEX__
CELERY_RESULT_BACKEND=redis://redis:6379/__REDIS_INDEX__

# M-Pesa -- CHANGE_ME: this company's own Daraja app credentials.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=CHANGE_ME
MPESA_CONSUMER_SECRET=CHANGE_ME
MPESA_SHORTCODE=CHANGE_ME
MPESA_PASSKEY=CHANGE_ME
MPESA_CALLBACK_URL=https://__HOST_IP__:__PORT__/api/payments/callback/

# MikroTik -- CHANGE_ME: this company's own router.
MIKROTIK_HOST=CHANGE_ME
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=CHANGE_ME
MIKROTIK_PORT=8728
MIKROTIK_PROVISION_INTERFACE=hotspot_bridge
CAPTIVE_PORTAL_URL=https://__HOST_IP__:__PORT__/portal

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://__HOST_IP__:__PORT__
CSRF_TRUSTED_ORIGINS=https://__HOST_IP__:__PORT__
