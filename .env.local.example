# Local Docker test settings only. deploy_local.sh refuses non-sandbox M-Pesa.
SECRET_KEY=local-only-insecure-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

DATABASE=postgres
DATABASE_URL=postgresql://isp_local:isp_local_password@db:5432/isp_local
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=isp_local
SQL_USER=isp_local
SQL_PASSWORD=isp_local_password
SQL_HOST=db
SQL_PORT=5432
POSTGRES_DB=isp_local
POSTGRES_USER=isp_local
POSTGRES_PASSWORD=isp_local_password

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://localhost/api/payments/callback/

NOTIFICATIONS_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
MIKROTIK_HOST=127.0.0.1
MIKROTIK_USERNAME=disabled
MIKROTIK_PASSWORD=
MIKROTIK_PORT=8728
MIKROTIK_USE_SSL=False
CAPTIVE_PORTAL_URL=https://localhost/portal

CORS_ALLOWED_ORIGINS=https://localhost
CSRF_TRUSTED_ORIGINS=https://localhost