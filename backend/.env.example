# Environment variables
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: postgresql://user:password@localhost:5432/isp_billing

# M-Pesa Configuration
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/callback/

# MikroTik Configuration
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=your_password
MIKROTIK_PORT=8728
MIKROTIK_USE_SSL=False
# Bridge Hotspot/PPPoE provisioning creates (if missing) and binds to on
# every router. Ports enslaved to it are controlled by
# MIKROTIK_PROVISION_BRIDGE_PORTS below -- check real port/interface names
# via the "Test Connection & List Interfaces" button in Add Router.
MIKROTIK_PROVISION_INTERFACE=hotspot_bridge
MIKROTIK_PROVISION_BRIDGE_PORTS=ether2,ether3,ether4,wlan1
# Default captive portal URL suggested for new/reprovisioned routers -- set
# this to wherever the app is actually reachable in this environment (a LAN
# IP while testing, the real domain when deploying).
CAPTIVE_PORTAL_URL=https://yourdomain.com/portal

# RADIUS Configuration (Optional)
RADIUS_SERVER=127.0.0.1
RADIUS_SECRET=testing123
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Origins allowed to submit session-authenticated POSTs (Django admin forms
# etc). Must include wherever you actually access /django-admin/ from, or
# every admin form submission fails with "CSRF verification failed".
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://yourdomain.com
